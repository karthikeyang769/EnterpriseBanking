        },
        "Transforms": [
          { "PathPattern": "/api/reports/{remainder}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:8080"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customer-service:8080"
          }
        }
      },
      "account-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://account-service:8080"
          }
        }
      },
      "beneficiary-cluster": {

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-swagger-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/swagger-docs/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger-docs/auth" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "customer-swagger-route": {
        "ClusterId": "customer-cluster",
        "Order": 1,
        "Match": {
          "Path": "/swagger-docs/customers/{**remainder}"
        },
